# GA-08 Civic Resource Hub — environment variables
#
# Frontend (Vite) vars MUST be prefixed VITE_ and are PUBLIC — never put
# secrets here. Real secrets (API keys, etc.) belong in Amplify backend
# secrets (`npx ampx sandbox secret set <name>`), not in this file, and
# are read server-side only (Lambda functions), never shipped to the
# browser. See docs/architecture.md "Security" section.

# --- Amazon Connect (Phase 4) ---
# See docs/connect-setup.md for how to obtain each value.
#
# FRONTEND (VITE_*, public) — these only decide whether the /help page
# OFFERS chat / voice. Starting a contact always goes through the
# `startSupportContact` backend mutation, which holds the credentials.
VITE_CONNECT_REGION=us-east-1
# "true" once the custom in-page chat widget is wired to a live instance.
VITE_CONNECT_CHAT_ENABLED=false
# "true" once in-browser WebRTC voice (Amazon Chime SDK) is enabled + tested.
VITE_CONNECT_VOICE_ENABLED=false
# Optional: use the zero-code hosted Amazon Connect chat widget instead of
# the custom one. Needs the snippet id + script URL from the Connect
# console (Communications widgets -> Get widget script).
VITE_CONNECT_USE_HOSTED_WIDGET=false
VITE_CONNECT_HOSTED_WIDGET_SNIPPET_ID=
VITE_CONNECT_HOSTED_WIDGET_URL=
#
# BACKEND (read by amplify/functions/connect-contact) — set per
# environment via `npx ampx sandbox secret set NAME` or Amplify Hosting
# env vars. Until these are set the mutation returns
# { ok: false, reason: "not_configured" } and the UI degrades gracefully.
# CONNECT_INSTANCE_ID            — the Connect instance GUID
# CONNECT_CHAT_CONTACT_FLOW_ID   — flow that greets -> Lex bot -> handoff
# CONNECT_VOICE_CONTACT_FLOW_ID  — same, for WebRTC voice contacts
#   (both flows are in docs/connect-flows/inbound-flow.json)

# --- Guided triage (Phase 3) — backend-only, read by the Lambda ---
# BEDROCK_MODEL_ID  — Bedrock Runtime (Converse API) model id, used by
#                     guided-triage and lex-fulfillment. Set per environment
#                     via `npx ampx sandbox secret set BEDROCK_MODEL_ID`
#                     (or an Amplify Hosting env var). Defaults in code to:
#                        us.anthropic.claude-sonnet-5
#                     VERIFIED 2026-09-08 in us-east-1 (ACTIVE inference
#                     profile + live Converse call incl. tool use). Note:
#                     NO date/version suffix — unlike Sonnet 4.5's
#                     us.anthropic.claude-sonnet-4-5-20250929-v1:0. Newer
#                     Claude models are INFERENCE_PROFILE-only on Bedrock,
#                     so the "us." (or "global.") prefix is required.
#                     Do NOT pass temperature/topP/topK with Sonnet 5 —
#                     sampling params are removed and return a 400.
# KNOWLEDGE_BASE_ID — optional Bedrock Knowledge Base id. Empty = use the
#                     in-Lambda lexical scorer over the Resource table.
# (RESOURCE_TABLE_NAME is injected automatically by amplify/backend.ts.)

# --- Backend-only secrets (set via `npx ampx sandbox secret set NAME`,
#     never read from this file at runtime) ---
# CONGRESS_GOV_API_KEY      — api.congress.gov key, used by
#                              amplify/functions/congress-sync (Phase 5)
