# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Amplify Gen 2
.amplify/
amplify/#current-cloud-backend/

# NOTE on amplify_outputs.json:
# In most Amplify Gen 2 projects this file is git-ignored because it's
# environment-specific (regenerated by `ampx sandbox` or by Amplify
# Hosting's build step) rather than a secret. This project currently
# commits a clearly-labeled PLACEHOLDER version of it (see the file
# itself) so `npm install && npm run dev` works before anyone has
# deployed a backend. Once you deploy your own sandbox/branch, either:
#   (a) uncomment the line below and stop tracking your real one, or
#   (b) keep committing it if you want a fresh clone to "just work"
#       against a shared dev backend (only do this for a non-prod
#       sandbox — never commit prod endpoints/keys this way).
# amplify_outputs.json

# Env files (never commit real secrets)
.env
.env.local
.env.*.local

# Editor/OS
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
*.log

# TypeScript incremental build cache
*.tsbuildinfo

# Local-only dev helper: wraps `npm run dev` with the portable Node.js
# install used in this sandboxed dev environment (no system Node.js was
# available). Hardcodes a machine-specific path — not meant to ship;
# on a normal machine with Node.js on PATH, just run `npm run dev`.
run-dev.bat
