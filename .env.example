# GA-08 Civic Resource Hub — environment variables
#
# Frontend (Vite) vars MUST be prefixed VITE_ and are PUBLIC — never put
# secrets here. Real secrets (API keys, etc.) belong in Amplify backend
# secrets (`npx ampx sandbox secret set <name>`), not in this file, and
# are read server-side only (Lambda functions), never shipped to the
# browser. See docs/architecture.md "Security" section.

# --- Amazon Connect (Phase 4) ---
# Connect instance access URL, e.g. https://your-instance.my.connect.aws
VITE_CONNECT_INSTANCE_URL=
# Chat/voice contact flow ID used for widget-initiated contacts
VITE_CONNECT_CONTACT_FLOW_ID=
# Connect instance ID (GUID)
VITE_CONNECT_INSTANCE_ID=
# Region the Connect instance lives in
VITE_CONNECT_REGION=us-east-1
# Toggle: set to "true" once web voice (WebRTC) has been enabled on the
# instance and tested; the UI hides the "Call for help" button otherwise
# so it never advertises a capability that isn't actually live.
VITE_CONNECT_VOICE_ENABLED=false

# --- Backend-only secrets (set via `npx ampx sandbox secret set NAME`,
#     never read from this file at runtime) ---
# CONGRESS_GOV_API_KEY      — api.congress.gov key, used by
#                              amplify/functions/congress-sync (Phase 5)
# BEDROCK_MODEL_ID           — Bedrock Runtime model id used by
#                              guided-triage / lex-fulfillment / congress-sync
#                              (verify current model IDs in
#                              docs/architecture.md before deploying)
